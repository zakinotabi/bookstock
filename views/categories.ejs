<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/categories.css" />
</head>
<body>
  <%- include('navbar') %>

  <main class="page" id="categories-page">
    <h1 class="page-heading">Categories</h1>

    <div class="page-bar">
      <div class="summary-group">
        <div class="summary-chip"><%= categoriesList.length %> Categories</div>
        <div class="summary-chip"><%= allBooks.length %> Books</div>
      </div>
      <button class="btn btn-primary" id="openNewModalBtn">+ New category</button>
    </div>

    <div class="toolbar">
      <div class="search">
        <input class="input" type="text" placeholder="Search categories...">
      </div>
    </div>

    <div id="categories-grid">
      <% categoriesList.forEach(item => { %>
      <div class="category-card">
        <div class="category-name"><%= item.name %></div>
        <div class="category-count"><%= item.total_in_stock %> Books</div>
        <div class="category-actions">
          <a href="/books/category/view/<%= item.id %>">
          <button class="btn btn-small">Open</button>
          </a>
          <button class="btn btn-small editBtn" data-id="<%= item.id %>" data-category="<%= item.name %>">Edit</button>
        </div>
      </div>
      <% }); %>
    </div>
  </main>

<!-- Add Category Modal -->
  <%- include('partials/addCategoryModal') %>

<!-- Edit Category Modal -->
   <%- include('partials/editCategoryModal') %>

<script>

// Add event
<%- include('partials/scripts/addCategory.js') %>

// Edit event
<%- include('partials/scripts/editCategory.js') %>

</script>
</body>
</html>
