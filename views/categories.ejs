<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/categories.css" />
</head>
<body>
  <%- include('navbar') %>

  <main class="page" id="categories-page">
    <h1 class="page-heading">Categories</h1>

    <div class="page-bar">
      <div class="summary-group">
        <div class="summary-chip"><%= categoriesList.length %> Categories</div>
        <div class="summary-chip"><%= allBooks.length %> Books</div>
      </div>
      <button class="btn btn-primary" id="openNewModalBtn">New category</button>
    </div>

    <div class="toolbar">
      <div class="search">
        <input class="input" type="text" placeholder="Search categories...">
      </div>
    </div>

    <div id="categories-grid">
      <% categoriesList.forEach(item => { %>
      <div class="category-card">
        <div class="category-name"><%= item.name %></div>
        <div class="category-count"><%= item.total_in_stock %> Books</div>
        <div class="category-actions">
          <a href="/books/category/view/<%= item.id %>">
          <button class="btn btn-small">Open</button>
          </a>
          <button class="btn btn-small editBtn" data-id="<%= item.id %>" data-category="<%= item.name %>">Edit</button>
        </div>
      </div>
      <% }); %>
    </div>
  </main>

  <!-- Add Category Modal -->
  <dialog class="modal" id="addModal">
    <form class="modal-form" action="/categories/add" method="POST">
      <h3 class="modal-title">Add New Category</h3>

      <div class="form-group">
        <label for="addCategoryInput">Category Name:</label>
        <input class="input" type="text" id="addCategoryInput" name="category" required placeholder="Enter category name">
      </div>

      <div class="modal-actions">
        <button class="btn" type="button" id="closeAddBtn">Cancel</button>
        <button class="btn btn-primary" type="submit">Save</button>
      </div>
    </form>
  </dialog>

  <!-- Edit Category Modal -->
  <dialog class="modal" id="editModal">
    <form class="modal-form" action="/categories/edit" method="POST">
      <h3 class="modal-title">Edit Category</h3>

      <input type="hidden" id="editCategoryId" name="oldCategory">

      <div class="form-group">
        <label for="editCategoryInput">Category Name:</label>
        <input class="input" type="text" id="editCategoryInput" name="newCategory" required>
      </div>

      <div class="modal-actions">
        <button class="btn" type="button" id="closeEditBtn">Cancel</button>
        <button class="btn btn-primary" type="submit">Update</button>
      </div>
    </form>
  </dialog>

<script>
  const addModal = document.getElementById('addModal');
  const editModal = document.getElementById('editModal');
  const addInput = document.getElementById('addCategoryInput');
  const currentCategory = document.getElementById('editCategoryId');
  const editNameInput = document.getElementById('editCategoryInput');

  // Add modal
  document.getElementById('openNewModalBtn').addEventListener('click', () => {
    addInput.value = '';
    addModal.showModal();
  });

  document.getElementById('closeAddBtn').addEventListener('click', () => {
    addModal.close();
  });

  // Edit modal
  document.querySelectorAll('.editBtn').forEach(button => {
    button.addEventListener('click', (e) => {
      editNameInput.value = e.currentTarget.dataset.category;
      currentCategory.value = e.currentTarget.dataset.category;
      editModal.showModal();
    });
  });

  document.getElementById('closeEditBtn').addEventListener('click', () => {
    editModal.close();
  });
</script>
</body>
</html>
