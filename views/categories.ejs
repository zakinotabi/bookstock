<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
  <%- include('navbar') %>
  
    <h2>Categories</h2>


<div>
  <div>
    <h1>Categories</h1>
    <div><%= categoriesList.length %> Categories</div>
    <div><%= allBooks.length %> Books</div>
  </div>
  <button>New category</button>
</div>
<div>

  <div>
    <div class="search"><input type="text" placeholder="Search categories..."></div>
  </div>
</div>
<div>
<% categoriesList.forEach(item => { %>
  <div>
    <div><%= item.category %></div>
    <div><%= item.total_in_stock %> Books</div>
    <div>
      <button>Open</button>
      <button>Edit</button>
    </div>
  </div>
<% }); %>
</div>

    

</body>
</html>