<!-- View Book Modal -->
<dialog class="modal" id="viewModal">
  <div class="modal-form view-modal">
    <div class="view-cover">Book Cover</div>

    <h3 class="modal-title view-title" id="viewTitle"></h3>

    <div class="view-details">
      <div class="view-row">
        <span class="view-label">Author</span>
        <span id="viewAuthor"></span>
      </div>
      <div class="view-row">
        <span class="view-label">Category</span>
        <span id="viewCategory"></span>
      </div>
      <div class="view-row">
        <span class="view-label">Price</span>
        <span>$ <span id="viewPrice"></span></span>
      </div>
      <div class="view-row">
        <span class="view-label">Stock</span>
        <span><span id="viewStock"></span> item</span>
      </div>
    </div>

    <div class="modal-actions">
      <button class="btn" type="button" id="closeViewBtn">Close</button>
    </div>
  </div>
</dialog>
