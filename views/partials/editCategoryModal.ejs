<!-- Edit Category Modal -->
<dialog class="modal" id="editModal">
  <form class="modal-form" action="/categories/edit" method="POST">
    <h3 class="modal-title">Edit Category</h3>

    <input type="hidden" id="editCategoryId" name="oldCategory" />

    <div class="form-group">
      <label for="editCategoryInput">Category Name:</label>
      <input class="input" type="text" id="editCategoryInput" name="newCategory" required />
    </div>

    <div class="modal-actions">
      <button class="btn" type="button" id="closeEditBtn">Cancel</button>
      <button class="btn btn-primary" type="submit">Update</button>
    </div>
  </form>
</dialog>
