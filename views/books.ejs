<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
  <%- include('navbar') %>
  
    <h2>All Books</h2>

<ul>
  <% booksList.forEach(book => { %>
    <li>
      <strong><%= book.title %></strong> by <%= book.author %> - $<%= book.price %>
    </li>
  <% }); %>
</ul>
</body>
</html>