<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Books</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/books.css" />
</head>
<body>
  <%- include('navbar') %>

  <main class="page" id="books-page">
    <h1 class="page-heading">All Books</h1>

    <div class="page-bar">
      <div class="page-summary"><%= booksList.length %> Books across <%= categoriesList.length %> categories</div>
      <button class="btn btn-primary" id="openNewModalBtn">+ New Book</button>
    </div>

    <div class="toolbar">
      <div class="search">
        <input class="input" type="text" placeholder="Search items...">
      </div>


      <select class="select" id="category-select">
        <option value="all">Category: All</option>
        <% categoriesList.forEach(item => { %>
          <option value="<%= item.id %>"><%= item.name %></option>
        <% }); %>
      </select>

      <select class="select">
        <option>Sort: Newest</option>
        <option>Sort: Name</option>
        <option>Sort: Price</option>
      </select>
    </div>


  <!-- Book Table -->
  
    <div class="table-wrap">
    <%- include('partials/booksTable', { booksList }) %>
    </div>


  <!-- navigation -->

    <div class="pagination">
      <button class="page-btn">‹ Prev</button>
      <button class="page-btn active">1</button>
      <button class="page-btn">2</button>
      <button class="page-btn">3</button>
      <button class="page-btn">Next ›</button>
    </div>
  </main>

  
<!-- View Book Modal -->
  <%- include('partials/viewBookModal') %>

<!-- Add Book Modal -->
  <%- include('partials/addBookModal') %>

<!-- Edit Book Modal -->
  <%- include('partials/editBookModal') %>

<!-- Delete Book Modal -->
  <%- include('partials/deleteBookModal') %>



<script>

  // add event
  <%- include('partials/scripts/addBook.js') %>

  // edit event
  <%- include('partials/scripts/editBook.js') %>

  // delete event
  <%- include('partials/scripts/deleteBook.js') %>

// view event
  <%- include('partials/scripts/viewBook.js') %>

  
// filter category event
  <%- include('partials/scripts/filterCategory.js') %>

</script>
</body>
</html>
