<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Books</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/books.css" />
</head>
<body>
  <%- include('navbar') %>

  <main class="page" id="books-page">
    <h1 class="page-heading">All Books</h1>

    <div class="page-bar">
      <div class="page-summary"><%= booksList.length %> Books across <%= categoriesList.length %> categories</div>
      <button class="btn btn-primary" id="openNewModalBtn">+ New Book</button>
    </div>

    <div class="toolbar">
      <div class="search">
        <input class="input" type="text" placeholder="Search items...">
      </div>
      <select class="select">
        <option>Category: All</option>
        <% categoriesList.forEach(item => { %>
        <option><%= item.name %></option>
        <% }); %>
      </select>
      <select class="select">
        <option>Sort: Newest</option>
        <option>Sort: Name</option>
        <option>Sort: Price</option>
      </select>
    </div>

    <div class="table-wrap">
      <table class="items-table" id="books-table">
        <thead>
          <tr>
            <th class="col-name">Name</th>
            <th>Author</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% booksList.forEach(book => { %>
          <tr>
            <td class="cell-title">
              <span><%= book.title %></span>
            </td>
            <td class="cell-muted"><%= book.author %></td>
            <td class="cell-muted"><%= book.category %></td>
            <td class="cell-number">$ <%= book.price %></td>
            <td class="cell-number">
              <span class="stock-badge <%= book.stock == 0 ? 'is-out' : (book.stock <= 5 ? 'is-low' : '') %>"><%= book.stock %> item</span>
            </td>
            <td class="cell-action">
              <div class="row-actions">
                <button class="btn btn-small">View</button>
                <button class="btn btn-small editBtn"
                  data-id="<%= book.id %>"
                  data-title="<%= book.title %>"
                  data-author="<%= book.author %>"
                  data-category-id="<%= book.category_id %>"
                  data-price="<%= book.price %>"
                  data-stock="<%= book.stock %>">Edit</button>
                <button class="btn btn-small btn-danger btn-icon deleteBtn"
                  data-id="<%= book.id %>"
                  data-title="<%= book.title %>" aria-label="Delete <%= book.title %>">🗑</button>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="pagination">
      <button class="page-btn">‹ Prev</button>
      <button class="page-btn active">1</button>
      <button class="page-btn">2</button>
      <button class="page-btn">3</button>
      <button class="page-btn">Next ›</button>
    </div>
  </main>

  <!-- Add Book Modal -->
  <dialog class="modal" id="addModal">
    <form class="modal-form" action="/books/add" method="POST">
      <h3 class="modal-title">Add New Book</h3>

      <div class="form-group">
        <label for="addTitleInput">Title:</label>
        <input class="input" type="text" id="addTitleInput" name="title" required placeholder="Enter book title">
      </div>

      <div class="form-group">
        <label for="addAuthorInput">Author:</label>
        <input class="input" type="text" id="addAuthorInput" name="author" required placeholder="Enter author name">
      </div>

      <div class="form-group">
        <label for="addCategorySelect">Category:</label>
        <select class="select" id="addCategorySelect" name="categoryId" required>
          <option value="" disabled selected>Select a category</option>
          <% categoriesList.forEach(item => { %>
            <option value="<%= item.id %>"><%= item.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="addPriceInput">Price:</label>
        <input class="input" type="number" id="addPriceInput" name="price" required min="0" step="0.01" placeholder="0.00">
      </div>

      <div class="form-group">
        <label for="addStockInput">Stock:</label>
        <input class="input" type="number" id="addStockInput" name="stock" required min="0" step="1" placeholder="0">
      </div>

      <div class="modal-actions">
        <button class="btn" type="button" id="closeAddBtn">Cancel</button>
        <button class="btn btn-primary" type="submit">Save</button>
      </div>
    </form>
  </dialog>

  <!-- Edit Book Modal -->
  <dialog class="modal" id="editModal">
    <form class="modal-form" action="/books/edit" method="POST">
      <h3 class="modal-title">Edit Book</h3>

      <input type="hidden" id="editBookId" name="currentBookId">

      <div class="form-group">
        <label for="editTitleInput">Title:</label>
        <input class="input" type="text" id="editTitleInput" name="title" required>
      </div>

      <div class="form-group">
        <label for="editAuthorInput">Author:</label>
        <input class="input" type="text" id="editAuthorInput" name="author" required>
      </div>

      <div class="form-group">
        <label for="editCategorySelect">Category:</label>
        <select class="select" id="editCategorySelect" name="categoryId" required>
          <% categoriesList.forEach(item => { %>
            <option value="<%= item.id %>"><%= item.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-group">
        <label for="editPriceInput">Price:</label>
        <input class="input" type="number" id="editPriceInput" name="price" required min="0" step="0.01">
      </div>

      <div class="form-group">
        <label for="editStockInput">Stock:</label>
        <input class="input" type="number" id="editStockInput" name="stock" required min="0" step="1">
      </div>

      <div class="modal-actions">
        <button class="btn" type="button" id="closeEditBtn">Cancel</button>
        <button class="btn btn-primary" type="submit">Update</button>
      </div>
    </form>
  </dialog>

  <!-- Delete Book Modal -->
  <dialog class="modal" id="deleteModal">
    <form class="modal-form" action="/books/delete" method="POST">
      <h3 class="modal-title">Remove Book</h3>

      <input type="hidden" id="deleteBookId" name="currentBookId">

      <p class="modal-text">Remove "<span id="deleteBookTitle"></span>" Book? Are you sure?</p>

      <div class="modal-actions">
        <button class="btn" type="button" id="closeDeleteBtn">Cancel</button>
        <button class="btn btn-danger" type="submit">Delete</button>
      </div>
    </form>
  </dialog>

<script>
  const addModal = document.getElementById('addModal');
  const addForm = addModal.querySelector('form');

  const editModal = document.getElementById('editModal');
  const editIdInput = document.getElementById('editBookId');
  const editTitleInput = document.getElementById('editTitleInput');
  const editAuthorInput = document.getElementById('editAuthorInput');
  const editCategorySelect = document.getElementById('editCategorySelect');
  const editPriceInput = document.getElementById('editPriceInput');
  const editStockInput = document.getElementById('editStockInput');

  const deleteModal = document.getElementById('deleteModal');
  const deleteIdInput = document.getElementById('deleteBookId');
  const deleteTitleSpan = document.getElementById('deleteBookTitle');

  // add event
  document.getElementById('openNewModalBtn').addEventListener('click', () => {
    addForm.reset();
    addModal.showModal();
  });

  document.getElementById('closeAddBtn').addEventListener('click', () => {
    addModal.close();
  });

  // edit event
  document.querySelectorAll('.editBtn').forEach(button => {
    button.addEventListener('click', (e) => {
      const d = e.currentTarget.dataset;
      editIdInput.value = d.id;
      editTitleInput.value = d.title;
      editAuthorInput.value = d.author;
      editCategorySelect.value = d.categoryId;
      editPriceInput.value = d.price;
      editStockInput.value = d.stock;
      editModal.showModal();
    });
  });

  document.getElementById('closeEditBtn').addEventListener('click', () => {
    editModal.close();
  });

  // delete event
  document.querySelectorAll('.deleteBtn').forEach(button => {
    button.addEventListener('click', (e) => {
      const d = e.currentTarget.dataset;
      deleteIdInput.value = d.id;
      deleteTitleSpan.textContent = d.title;
      deleteModal.showModal();
    });
  });

  document.getElementById('closeDeleteBtn').addEventListener('click', () => {
    deleteModal.close();
  });
</script>
</body>
</html>
