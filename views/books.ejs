<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
  <%- include('navbar') %>
  
    

    <h1>All Books</h1>

<div>
  <div>
    <div><%= booksList.length %> Books across <%= categoriesList.length %> categories</div>
  </div>
  <button id="openNewModalBtn">+ New Book</button>
</div>

<div>
  <div>
    <input type="text" placeholder="Search items...">
  </div>
  <select>
    <option>Category: All</option>
    <% categoriesList.forEach(item => { %>
    <option><%= item.name %></option>
    <% }); %>
  </select>
  <select>
    <option>Sort: Newest</option>
    <option>Sort: Name</option>
    <option>Sort: Price</option>
  </select>
</div>

<div>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Author</th>
        <th>Category</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% booksList.forEach(book => { %>
      <tr>
        <td>          
          <span><%= book.title %></span>
        </td>
        <td><%= book.author %></td>
        <td><%= book.category %></td>
        <td>$ <%= book.price %></td>
        <td><%= book.stock %> item</td>
        <td>
          <div>
            <button>View</button>
            <button class="editBtn"
            data-id="<%= book.id %>"
            data-title="<%= book.title %>"
            data-author="<%= book.author %>"
            data-category-id="<%= book.category_id %>"
            data-price="<%= book.price %>"
            data-stock="<%= book.stock %>">Edit</button>
            <button>🗑</button>
          </div>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div>
  <button>‹ Prev</button>
  <button>1</button>
  <button>2</button>
  <button>3</button>
  <button>Next ›</button>
</div>
    
<!-- Add Book Modal -->
<dialog id="addModal">
  <form action="/books/add" method="POST">
    <h3>Add New Book</h3>

    <div>
      <label for="addTitleInput">Title:</label>
      <input type="text" id="addTitleInput" name="title" required placeholder="Enter book title">
    </div>

    <div>
      <label for="addAuthorInput">Author:</label>
      <input type="text" id="addAuthorInput" name="author" required placeholder="Enter author name">
    </div>

    <div>
      <label for="addCategorySelect">Category:</label>
      <select id="addCategorySelect" name="categoryId" required>
        <option value="" disabled selected>Select a category</option>
        <% categoriesList.forEach(item => { %>
          <option value="<%= item.id %>"><%= item.name %></option>
        <% }); %>
      </select>
    </div>

    <div>
      <label for="addPriceInput">Price:</label>
      <input type="number" id="addPriceInput" name="price" required min="0" step="0.01" placeholder="0.00">
    </div>

    <div>
      <label for="addStockInput">Stock:</label>
      <input type="number" id="addStockInput" name="stock" required min="0" step="1" placeholder="0">
    </div>

    <div>
      <button type="button" id="closeAddBtn">Cancel</button>
      <button type="submit">Save</button>
    </div>
  </form>
</dialog>
<!-- Edit Book Modal -->
<dialog id="editModal">
  <form action="/books/edit" method="POST">
    <h3>Edit Book</h3>

    <input type="hidden" id="editBookId" name="currentBookId">

    <div>
      <label for="editTitleInput">Title:</label>
      <input type="text" id="editTitleInput" name="title" required>
    </div>

    <div>
      <label for="editAuthorInput">Author:</label>
      <input type="text" id="editAuthorInput" name="author" required>
    </div>

    <div>
      <label for="editCategorySelect">Category:</label>
      <select id="editCategorySelect" name="categoryId" required>
        <% categoriesList.forEach(item => { %>
          <option value="<%= item.id %>"><%= item.name %></option>
        <% }); %>
      </select>
    </div>

    <div>
      <label for="editPriceInput">Price:</label>
      <input type="number" id="editPriceInput" name="price" required min="0" step="0.01">
    </div>

    <div>
      <label for="editStockInput">Stock:</label>
      <input type="number" id="editStockInput" name="stock" required min="0" step="1">
    </div>

    <div>
      <button type="button" id="closeEditBtn">Cancel</button>
      <button type="submit">Update</button>
    </div>
  </form>
</dialog>

</body>
<script>
  const addModal = document.getElementById('addModal');
  const addForm = addModal.querySelector('form');
  const editModal = document.getElementById('editModal');
  const editIdInput = document.getElementById('editBookId');
  const editTitleInput = document.getElementById('editTitleInput');
  const editAuthorInput = document.getElementById('editAuthorInput');
  const editCategorySelect = document.getElementById('editCategorySelect');
  const editPriceInput = document.getElementById('editPriceInput');
  const editStockInput = document.getElementById('editStockInput');

  document.getElementById('openNewModalBtn').addEventListener('click', () => {
    addForm.reset();
    addModal.showModal();
  });

  document.getElementById('closeAddBtn').addEventListener('click', () => {
    addModal.close();
  });



document.querySelectorAll('.editBtn').forEach(button => {
  button.addEventListener('click', (e) => {
    const d = e.currentTarget.dataset;
    editIdInput.value = d.id;
    editTitleInput.value = d.title;
    editAuthorInput.value = d.author;
    editCategorySelect.value = d.categoryId;
    editPriceInput.value = d.price;
    editStockInput.value = d.stock;
    editModal.showModal();
  });
});

document.getElementById('closeEditBtn').addEventListener('click', () => {
  editModal.close();
});
</script>
</html>